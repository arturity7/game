 "babilonia.dialogo.mathon": {
  "quem": "Mathon",
  "inicio": [
   {
    "se": {
     "sem_flag": "babilonia.conheceu_mathon"
    },
    "ir": "chegada"
   },
   {
    "ir": "menu"
   }
  ],
  "nos": {
   "chegada": {
    "fala": [
     "Sou Mathon, emprestador de ouro e joalheiro.",
     "Nesta caixa de couro vermelho guardo os penhores de quem me pede dinheiro."
    ],
    "efeitos": [
     {
      "flag": "babilonia.conheceu_mathon"
     }
    ],
    "ir": "menu"
   },
   "menu": {
    "fala": "Precisa de alguma coisa?",
    "escolhas": [
     {
      "texto": "O que é a muralha?",
      "ir": "muralha",
      "se": {
       "sem_flag": "babilonia.muralha"
      }
     },
     {
      "texto": "Me ensina algo?",
      "ir": "licao"
     },
     {
      "texto": "Até logo.",
      "ir": "fim"
     }
    ]
   },
   "muralha": {
    "fala": [
     "Na Babilônia, as muralhas protegiam a cidade dos inimigos.",
     "Por $ 100, eu te dou uma muralha: se um dia você desmaiar, perde só metade do que perderia."
    ],
    "escolhas": [
     {
      "texto": "Quero a muralha ($ 100).",
      "ir": "compra",
      "se": {
       "dinheiro": 100
      }
     },
     {
      "texto": "Agora não.",
      "ir": "menu"
     }
    ]
   },
   "compra": {
    "fala": "Feito. Agora você está protegido.",
    "efeitos": [
     {
      "dinheiro": -100
     },
     {
      "flag": "babilonia.muralha"
     }
    ],
    "ir": "menu"
   },
   "licao": {
    "ramos": [
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.dabasir"
      },
      "ir": "q_dabasir"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.megiddo"
      },
      "ir": "q_megiddo"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.rodan"
      },
      "ir": "q_rodan"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.tampa"
      },
      "ir": "q_tampa"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.cavalo_asno"
      },
      "ir": "q_cavalo_asno"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.sira"
      },
      "ir": "q_sira"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.doze_luas"
      },
      "ir": "q_doze_luas"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.semiramis"
      },
      "ir": "q_semiramis"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.assirios"
      },
      "ir": "q_assirios"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.bolinhos"
      },
      "ir": "q_bolinhos"
     },
     {
      "se": {
       "nao_acertou": "babilonia.pergunta.arad_gula"
      },
      "ir": "q_arad_gula"
     },
     {
      "ir": "licao_fim"
     }
    ]
   },
   "licao_certa": {
    "fala": "Muito bem. Tome, $ 5 pela boa memória.",
    "efeitos": [
     {
      "dinheiro": 5
     }
    ],
    "escolhas": [
     {
      "texto": "Outra.",
      "ir": "licao"
     },
     {
      "texto": "Voltar.",
      "ir": "menu"
     }
    ]
   },
   "licao_errada": {
    "fala": "Hum, não. Quem empresta sem pensar se arrepende; quem responde sem lembrar também.",
    "ir": "menu"
   },
   "licao_fim": {
    "fala": "Você já sabe tudo o que eu sei contar.",
    "ir": "menu"
   },
