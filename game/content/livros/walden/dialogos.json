 "walden.dialogo.lenhador": {
  "quem": "Lenhador",
  "inicio": [
   {
    "ir": "oi"
   }
  ],
  "nos": {
   "oi": {
    "fala": [
     "Bom dia, bom dia! Ha-ha! Que dia bonito para cortar lenha!",
     "Eu nunca fico cansado. Quer ver? Os passarinhos até pousam no meu braço enquanto eu almoço."
    ],
    "efeitos": [
     {
      "flag": "walden.conheceu_lenhador"
     }
    ],
    "escolhas": [
     {
      "texto": "Me pergunta algo?",
      "ir": "quiz"
     },
     {
      "texto": "Até logo.",
      "ir": "fim"
     }
    ]
   },
   "quiz": {
    "ramos": [
     {
      "se": {
       "nao_acertou": "walden.pergunta.balde"
      },
      "ir": "q_balde"
     },
     {
      "se": {
       "nao_acertou": "walden.pergunta.postes"
      },
      "ir": "q_postes"
     },
     {
      "ir": "quiz_fim"
     }
    ]
   },
   "quiz_certo": {
    "fala": "Ha-ha! Isso mesmo! Tome, pela boa memória.",
    "efeitos": [
     {
      "dinheiro": 6
     }
    ],
    "escolhas": [
     {
      "texto": "Outra!",
      "ir": "quiz"
     },
     {
      "texto": "Até logo.",
      "ir": "fim"
     }
    ]
   },
   "quiz_errado": {
    "fala": "Ha-ha! Não, não. Mas tudo bem, amanhã tem mais!",
    "ir": "fim"
   },
   "quiz_fim": {
    "fala": "Você sabe tudo de mim! Ha-ha!",
    "ir": "fim"
   },
   "q_balde": {
    "pergunta": "walden.pergunta.balde",
    "certo": "quiz_certo",
    "errado": "quiz_errado"
   },
   "q_postes": {
    "pergunta": "walden.pergunta.postes",
    "certo": "quiz_certo",
    "errado": "quiz_errado"
   }
  }
 }
