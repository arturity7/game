 "percy_1.dialogo.estante": {
  "quem": "Arena",
  "inicio": [
   {
    "se": {
     "item": "percy_1.item.espada_acampamento"
    },
    "ir": "tem"
   },
   {
    "ir": "pega"
   }
  ],
  "nos": {
   "pega": {
    "fala": [
     "Espadas de bronze celestial do acampamento, cada uma de um tamanho.",
     "Você pega uma que não pesa demais."
    ],
    "efeitos": [
     {
      "dar_item": "percy_1.item.espada_acampamento"
     }
    ],
    "ir": "fim"
   },
   "tem": {
    "fala": "Você já tem uma espada de bronze.",
    "ir": "fim"
   }
  }
 },
 "percy_1.dialogo.luke": {
  "quem": "Luke",
  "inicio": [
   {
    "se": {
     "missao": "percy_1.missao.esgrima",
     "estado": "feita"
    },
    "ir": "quiz"
   },
   {
    "se": {
     "contador": "percy_1.bonecos",
     "minimo": 3
    },
    "ir": "aprovado"
   },
   {
    "se": {
     "missao": "percy_1.missao.esgrima",
     "estado": "ativa"
    },
    "ir": "treino"
   },
   {
    "ir": "oi"
   }
  ],
  "nos": {
   "oi": {
    "fala": [
     "Novo por aqui? Sou Luke, do chalé 11. Fale com Quíron primeiro, depois venha treinar."
    ],
    "ir": "fim"
   },
   "treino": {
    "fala": [
     "Pegue uma espada no suporte e derrube os bonecos de palha. Três, para começar.",
     "Use o botão esquerdo para golpear na direção do mouse."
    ],
    "ir": "fim"
   },
   "aprovado": {
    "fala": [
     "Nada mal! Você tem jeito para a coisa.",
     "Um dia eu ensino o golpe de desarmar: gira a lâmina contra a do outro e empurra para baixo.",
     "Antes, uma pergunta. Prestou atenção nas aulas?"
    ],
    "efeitos": [
     {
      "missao": "percy_1.missao.esgrima",
      "estado": "feita"
     },
     {
      "dar_item": "percy_1.item.dracma",
      "qtd": 2
     }
    ],
    "ir": "quiz"
   },
   "quiz": {
    "ramos": [
     {
      "se": {
       "nao_acertou": "percy_1.pergunta.desarmar"
      },
      "ir": "q_desarmar"
     },
     {
      "se": {
       "nao_acertou": "percy_1.pergunta.melhor_espadachim"
      },
      "ir": "q_melhor"
     },
     {
      "se": {
       "nao_acertou": "percy_1.pergunta.luke_chale"
      },
      "ir": "q_chale"
     },
     {
      "ir": "quiz_fim"
     }
    ]
   },
   "q_desarmar": {
    "pergunta": "percy_1.pergunta.desarmar",
    "certo": "quiz_certo",
    "errado": "quiz_errado"
   },
   "q_melhor": {
    "pergunta": "percy_1.pergunta.melhor_espadachim",
    "certo": "quiz_certo",
    "errado": "quiz_errado"
   },
   "q_chale": {
    "pergunta": "percy_1.pergunta.luke_chale",
    "certo": "quiz_certo",
    "errado": "quiz_errado"
   },
   "quiz_certo": {
    "fala": "Isso aí. Leve um dracma.",
    "efeitos": [
     {
      "dar_item": "percy_1.item.dracma"
     }
    ],
    "escolhas": [
     {
      "texto": "Outra!",
      "ir": "quiz"
     },
     {
      "texto": "Até mais.",
      "ir": "fim"
     }
    ]
   },
   "quiz_errado": {
    "fala": "Errou, mas tudo bem. Volte amanhã e tente de novo.",
    "ir": "fim"
   },
   "quiz_fim": {
    "fala": "Os bonecos ali não aguentam mais você. Bom treino!",
    "ir": "fim"
   }
  }
 },
 "percy_1.dialogo.grover_acampamento": {
  "quem": "Grover",
  "inicio": "a",
  "nos": {
   "a": {
    "fala": [
     "Eu sou um sátiro. Meu trabalho era cuidar de você na escola.",
     "E esse chifre que você trouxe? Guarde bem. É o seu troféu!",
     "Um dia eu quero a licença de buscador... mas isso é outra história."
    ],
    "ir": "fim"
   }
  }
 }
}
