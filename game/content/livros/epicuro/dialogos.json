      "ir": "quiz"
     },
     {
      "texto": "Chega por hoje.",
      "ir": "fim"
     }
    ]
   },
   "quiz_errado": {
    "fala": "Não... Mas a resposta está no livro. Releia e volte quando quiser.",
    "ir": "fim"
   },
   "quiz_fim": {
    "fala": "Você já sabe tudo o que eu ensinaria. Agora é só viver bem.",
    "ir": "fim"
