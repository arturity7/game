 "epicuro.dialogo.meneceu": {
  "quem": "Meneceu",
  "inicio": [
   {
    "se": {
     "flag": "epicuro.meneceu_leu"
    },
    "ir": "depois"
   },
   {
    "se": {
     "item": "epicuro.item.carta_meneceu"
    },
    "ir": "carta"
   },
   {
    "ir": "oi"
   }
  ],
  "nos": {
   "oi": {
    "fala": "Bom dia! Dizem que um filósofo mora num jardim, no norte da cidade.",
    "ir": "fim"
   },
   "carta": {
    "fala": [
     "Uma carta de Epicuro! Deixe-me ler...",
     "Ele diz que nem todo desejo é igual. Você me ajuda a separar estes?"
    ],
    "escolhas": [
     {
      "texto": "Ajudo.",
      "ir": "d1"
     },
     {
      "texto": "Depois.",
      "ir": "fim"
     }
    ]
   },
   "d1": {
    "pergunta": "epicuro.pergunta.desejo_agua",
    "certo": "d2",
    "errado": "errou"
   },
   "d2": {
    "pergunta": "epicuro.pergunta.desejo_abrigo",
    "certo": "d3",
    "errado": "errou"
   },
   "d3": {
    "pergunta": "epicuro.pergunta.desejo_banquete",
    "certo": "d4",
    "errado": "errou"
   },
   "d4": {
    "pergunta": "epicuro.pergunta.desejo_fama",
    "certo": "d5",
    "errado": "errou"
   },
   "d5": {
    "pergunta": "epicuro.pergunta.desejo_riqueza",
    "certo": "entendi",
    "errado": "errou"
   },
   "errou": {
    "fala": "Hum... acho que não é isso. A carta explica bem os três tipos.",
    "escolhas": [
     {
      "texto": "Vamos de novo.",
      "ir": "d1"
     },
     {
      "texto": "Depois eu volto.",
      "ir": "fim"
     }
    ]
   },
   "entendi": {
    "fala": [
     "Entendi! Muito do que eu queria nem era preciso.",
     "Vou guardar a carta comigo. Diga a Epicuro que eu li."
    ],
    "efeitos": [
     {
      "flag": "epicuro.meneceu_leu"
     },
     {
      "tirar_item": "epicuro.item.carta_meneceu"
     }
    ],
    "ir": "fim"
   },
   "depois": {
    "fala": "Obrigado pela carta. Estou desejando menos e dormindo melhor.",
    "ir": "fim"
   }
  }
 },
 "epicuro.dialogo.pitocles": {
  "quem": "Pítocles",
  "inicio": [
   {
    "se": {
     "flag": "epicuro.pitocles_leu"
    },
    "ir": "depois"
   },
   {
    "se": {
     "item": "epicuro.item.carta_pitocles"
    },
    "ir": "carta"
   },
   {
    "ir": "oi"
   }
  ],
  "nos": {
   "oi": {
    "fala": "Já reparou como o céu muda? Eu queria entender tudo isso sem decorar livros enormes.",
    "ir": "fim"
   },
   "carta": {
    "fala": [
     "A resposta de Epicuro! Eu tinha pedido um resumo curto sobre o céu.",
     "Vamos ver se entendi direito."
    ],
    "escolhas": [
     {
      "texto": "Vamos.",
      "ir": "p1"
     },
     {
      "texto": "Depois.",
      "ir": "fim"
     }
    ]
   },
   "p1": {
    "pergunta": "epicuro.pergunta.eclipse",
    "certo": "p2",
    "errado": "errou"
   },
   "p2": {
    "pergunta": "epicuro.pergunta.raio",
    "certo": "p3",
    "errado": "errou"
   },
   "p3": {
    "pergunta": "epicuro.pergunta.assunto_pitocles",
    "certo": "entendi",
    "errado": "errou"
   },
   "errou": {
    "fala": "Será? Acho que a carta diz outra coisa.",
    "escolhas": [
     {
      "texto": "Vamos de novo.",
      "ir": "p1"
     },
     {
      "texto": "Depois eu volto.",
      "ir": "fim"
     }
    ]
   },
   "entendi": {
    "fala": [
     "Então o céu pode ter várias explicações, e nenhuma delas precisa me dar medo.",
     "Agradeça a Epicuro por mim."
    ],
    "efeitos": [
     {
      "flag": "epicuro.pitocles_leu"
     },
     {
      "tirar_item": "epicuro.item.carta_pitocles"
     }
    ],
    "ir": "fim"
   },
   "depois": {
    "fala": "Hoje à noite vou olhar as estrelas sem medo nenhum.",
    "ir": "fim"
   }
  }
 },
 "epicuro.dialogo.herodoto": {
  "quem": "Heródoto",
  "inicio": [
   {
    "se": {
     "flag": "epicuro.herodoto_leu"
    },
    "ir": "depois"
   },
   {
    "se": {
     "item": "epicuro.item.carta_herodoto"
    },
    "ir": "carta"
   },
   {
    "ir": "oi"
   }
  ],
  "nos": {
   "oi": {
    "fala": "De que será feita esta pedra? E esta árvore? E nós?",
    "ir": "fim"
   },
   "carta": {
    "fala": [
     "O resumo da física, de Epicuro! Era o que eu esperava.",
     "Me ajuda a conferir o que ele diz?"
    ],
    "escolhas": [
     {
      "texto": "Ajudo.",
      "ir": "h1"
     },
     {
      "texto": "Depois.",
      "ir": "fim"
     }
    ]
   },
   "h1": {
    "pergunta": "epicuro.pergunta.corpos_vazio",
    "certo": "h2",
    "errado": "errou"
   },
   "h2": {
    "pergunta": "epicuro.pergunta.atomos",
    "certo": "h3",
    "errado": "errou"
   },
   "h3": {
    "pergunta": "epicuro.pergunta.alma",
    "certo": "entendi",
    "errado": "errou"
   },
   "errou": {
    "fala": "Hum, não é o que está escrito aqui.",
    "escolhas": [
     {
      "texto": "Vamos de novo.",
      "ir": "h1"
     },
     {
      "texto": "Depois eu volto.",
      "ir": "fim"
     }
    ]
   },
   "entendi": {
    "fala": [
     "Corpos, vazio e átomos de formas diferentes... Tudo faz sentido.",
     "Diga a Epicuro que a carta chegou."
    ],
    "efeitos": [
     {
      "flag": "epicuro.herodoto_leu"
     },
     {
      "tirar_item": "epicuro.item.carta_herodoto"
     }
    ],
    "ir": "fim"
   },
   "depois": {
    "fala": "Estou tentando imaginar o formato dos átomos desta maçã.",
    "ir": "fim"
   }
  }
 }
}
