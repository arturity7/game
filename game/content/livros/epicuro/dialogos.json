     }
    ]
   },
   "quiz_certo": {
    "fala": "Muito bem! Leve mais um bolo de cevada para a estrada.",
    "efeitos": [
     {
      "dar_item": "epicuro.item.bolo_cevada"
     }
    ],
    "escolhas": [
     {
